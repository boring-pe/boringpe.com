# Copy to deploy/.env and fill in. Never commit the filled-in file.
PORTAL_DOMAIN=portal.boringpe.com          # DNS A record pointing at this server
AUTH_URL=https://portal.boringpe.com
AUTH_SECRET=                               # openssl rand -base64 32
INTEGRATIONS_KEY=                          # openssl rand -base64 48 (seals saved keys and passwords)
POSTGRES_PASSWORD=                         # openssl rand -base64 24
BACKUP_PASSPHRASE=                         # long passphrase; store it apart from the server
SUPER_ADMIN_EMAILS=business@boringpe.com
ADMIN_BOOTSTRAP_PASSWORD=                  # first sign-in only, then remove
