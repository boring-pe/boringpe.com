# Required
AUTH_SECRET=            # openssl rand -base64 32
DATABASE_URL=           # Neon connection string (pooled). Omit locally: embedded Postgres is used.
AUTH_URL=               # e.g. https://portal.boringpe.com (optional on Vercel)

# First admin seat. Listed addresses may sign in even before they are invited.
ADMIN_EMAILS=you@example.com
# Creates the first admin with this password if that user does not exist yet.
# They must change it at first sign-in. Remove this variable afterwards.
ADMIN_BOOTSTRAP_PASSWORD=

# Optional sign-in methods. Each appears on the login page only when its keys are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
AUTH_RESEND_KEY=        # magic links, sent through Resend
AUTH_EMAIL_FROM=        # e.g. "Boring PE <portal@boringpe.com>"
